# --- Ignora todo por defecto ---
*

# --- Permite recorrer carpetas (necesario para que las reglas de abajo funcionen) ---
!*/

# --- Archivos necesarios en la raíz ---
!/index.html
!/Android Free Version/index.html
!/b3610_2022_data.js
!/b3619_2022_data.js
!/.gitignore
!/netlify.toml

# --- Netlify Functions (serverless) ---
!/netlify/functions/*.js
!/netlify/functions/_data/*.js

# --- Carpeta de imagenes SVG que la app carga en tiempo real ---
!/Fittings SVG/*.svg

# Local Netlify folder
.netlify
